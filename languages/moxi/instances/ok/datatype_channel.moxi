; A parametric algebraic datatype as a system's interface sort: the upstream
; LossyIntChannelX shape (moxi-mc-flow, GPL-3.0) reduced to one system and one
; query, with the constructor list parenthesized as the SMT-LIB grammar
; requires (the upstream file omits that paren level and its own header marks
; it unsupported). `(Event Real)` instantiates `Event`'s parameter; `Absent`
; is the nullary constructor and `Present`'s selector `val` projects the
; payload.
(set-logic QF_LRA)

(declare-datatype Event (par (X) ((Absent) (Present (val X)))))

; An event-triggered channel that arbitrarily loses its input data
(define-system LossyRealChannel
  :input  ((in (Event Real)))
  :output ((out (Event Real)))
  :local  ((s Bool))
  ; at all times, whether the input event is transmitted depends on s
  :inv    (= out (ite s in (as Absent (Event Real)))))

; A delivered event carries the input's payload: if out is Present, its val
; equals the input's val. Read as a safety question over the datatype.
(check-system LossyRealChannel
  :input  ((in (Event Real)))
  :output ((out (Event Real)))
  :local  ((s Bool))
  :reachable (mismatch (and ((_ is Present) out)
                            ((_ is Present) in)
                            (not (= (val out) (val in)))))
  :query (q (mismatch)))
