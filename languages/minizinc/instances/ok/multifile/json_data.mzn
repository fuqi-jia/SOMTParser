array[1..2, 1..3] of int: a;
set of int: allowed;
string: label;
array[1..2] of string: labels;
array[1..2] of set of int: memberships;
enum Color = {red, blue};
Color: favorite;
array[1..2] of Color: colors;
array[1..2, 1..2, 1..2] of int: cube;
var int: x;
var int: y;
var int: z;
constraint x = a[1, 2];
constraint a[2, 1] in allowed;
constraint label = "A\nB";
constraint labels[1] = "left";
constraint y in memberships[2];
constraint favorite = colors[2];
constraint favorite = blue;
constraint z = cube[2, 1, 2];
solve satisfy;
