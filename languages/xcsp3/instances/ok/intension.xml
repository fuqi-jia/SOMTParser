<instance format="XCSP3" type="CSP">
  <variables>
    <var id="x"> 0..10 </var>
    <var id="y"> 0..10 </var>
  </variables>
  <constraints>
    <intension> le(add(x, 3), 10) </intension>
    <intension> ne(x, y) </intension>
    <intension> or(lt(x, 2), gt(y, 8)) </intension>
    <intension> eq(dist(x, y), 4) </intension>
    <intension> imp(lt(x, 2), le(y, 5)) </intension>
    <intension> eq(abs(sub(x, y)), 4) </intension>
  </constraints>
</instance>
