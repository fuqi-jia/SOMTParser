<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..10 </var>
    <var id="y"> 0..10 </var>
  </variables>
  <constraints>
    <intension> ge(add(x, y), 5) </intension>
  </constraints>
  <objectives>
    <minimize type="sum">
      <list> x y </list>
      <coeffs> 2 3 </coeffs>
    </minimize>
  </objectives>
</instance>
