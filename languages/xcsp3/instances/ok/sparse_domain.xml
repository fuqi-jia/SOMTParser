<instance format="XCSP3" type="CSP">
  <variables>
    <!-- Not the range 1..7: 2, 4 and 6 are forbidden, and the bounds alone
         cannot say so. -->
    <var id="x"> 1 3 5 7 </var>
    <var id="y"> 0..3 </var>
  </variables>
  <constraints>
    <intension> lt(y, x) </intension>
  </constraints>
</instance>
