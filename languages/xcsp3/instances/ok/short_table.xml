<instance format="XCSP3" type="CSP">
  <variables>
    <!-- `s` has a SPARSE domain, so the wildcard in its column expands to
         `s = 2 or s = 5` rather than to the interval its bounds describe. -->
    <var id="s"> 2 5 </var>
    <var id="t"> 0..2 </var>
  </variables>
  <constraints>
    <extension>
      <list> s t </list>
      <supports> (*,1)(2,2) </supports>
    </extension>
  </constraints>
</instance>
