<instance format="XCSP3" type="COP">
  <variables>
    <var id="x"> 0..10 </var>
    <var id="y"> 0..10 </var>
  </variables>
  <constraints>
    <intension> ge(add(x, y), 5) </intension>
  </constraints>
  <objectives combination="pareto">
    <minimize> x </minimize>
    <maximize> y </maximize>
  </objectives>
</instance>
