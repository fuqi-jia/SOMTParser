# Doxygen (Doxyfile: OUTPUT_DIRECTORY=docs, HTML_OUTPUT=html, LATEX_OUTPUT=latex).
# Ignore only the generated subtrees -- `docs/` itself holds hand-written docs.
docs/html/
docs/latex/

# vscode
.vscode/

# conan
conan.lock
conanbuildinfo.txt
conaninfo.txt

# markdown
# Scratch notes at the repo root stay untracked, but real documentation does not.
*.md
!README.md
!CONTRIBUTORS.md
!docs/**/*.md
!languages/**/*.md
!tools/**/*.md
!skills/**/*.md
!AGENTS.md
# python
__pycache__/
*.pyc
dist/
*.egg-info/

# Raw experiment evidence is archived as private release assets with SHA-256 receipts.
/artifact/

# Local assistant state
.claude/
