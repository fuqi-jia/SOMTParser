{
  "type": "object",
  "properties": {
    "schema": {
      "const": "somt-nl-model-v1"
    },
    "semantics": {
      "const": "relational-v1"
    },
    "decision": {
      "enum": [
        "satisfiability",
        "optimization",
        "validity"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 1024
          },
          "span": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "name",
          "members",
          "span"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 16
          },
          "span": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "lower": {
            "type": [
              "integer",
              "string"
            ]
          },
          "upper": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "name",
          "sort",
          "arguments",
          "span"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expr": {
            "$ref": "#/$defs/expression"
          },
          "span": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "expr",
          "span"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "direction": {
            "enum": [
              "minimize",
              "maximize"
            ]
          },
          "expr": {
            "$ref": "#/$defs/expression"
          },
          "span": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "direction",
          "expr",
          "span"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    },
    "objective_order": {
      "enum": [
        "single",
        "lexicographic"
      ]
    },
    "goal": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/expression"
            },
            "span": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "expr",
            "span"
          ],
          "additionalProperties": false
        }
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schema",
    "semantics",
    "decision",
    "domains",
    "symbols",
    "constraints",
    "objectives",
    "objective_order",
    "goal",
    "assumptions",
    "unresolved"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "var": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "var"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "boolean"
            },
            "sort": {
              "const": "Bool"
            }
          },
          "required": [
            "literal",
            "sort"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "integer"
            },
            "sort": {
              "const": "Int"
            }
          },
          "required": [
            "literal",
            "sort"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "literal": {
              "type": "string",
              "pattern": "^[+-]?(?:\\d+(?:\\.\\d+)?|\\d+/[1-9]\\d*)$"
            },
            "sort": {
              "const": "Real"
            }
          },
          "required": [
            "literal",
            "sort"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "forall",
                "exists"
              ]
            },
            "var": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "domain": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "body": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "op",
            "var",
            "domain",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "tdiv",
                "neg",
                "lt",
                "le",
                "gt",
                "ge",
                "eq",
                "ne",
                "and",
                "or",
                "not",
                "implies",
                "ite"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "maxItems": 1024
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "call"
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expression"
              },
              "maxItems": 16
            }
          },
          "required": [
            "op",
            "symbol",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "description": "Typed NL candidate. Additional type, span, resource, and decision checks are performed by SOMTParser. An unresolved model may be saved but cannot compile."
}
