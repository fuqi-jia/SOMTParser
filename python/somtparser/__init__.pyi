    def str_to_int(self, a: Node) -> Node: ...
    def str_to_code(self, a: Node) -> Node: ...
    def str_from_code(self, a: Node) -> Node: ...
    def str_in_re(self, s: Node, r: Node) -> Node: ...
    def str_to_re(self, s: Node) -> Node: ...
    # Regular expressions
    def re_none(self) -> Node: ...
    def re_all(self) -> Node: ...
    def re_allchar(self) -> Node: ...
    def re_concat(self, args: Sequence[Node]) -> Node: ...
    def re_union(self, args: Sequence[Node]) -> Node: ...
    def re_inter(self, args: Sequence[Node]) -> Node: ...
    def re_diff(self, args: Sequence[Node]) -> Node: ...
    def re_star(self, r: Node) -> Node: ...
    def re_plus(self, r: Node) -> Node: ...
    def re_opt(self, r: Node) -> Node: ...
    def re_range(self, lo: Node, hi: Node) -> Node: ...
    def re_complement(self, r: Node) -> Node: ...
    # Quantifiers
    def forall(self, vars: Sequence[Node], body: Node) -> Node: ...
    def exists(self, vars: Sequence[Node], body: Node) -> Node: ...
    # Functions
