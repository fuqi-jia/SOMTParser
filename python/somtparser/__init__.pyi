    def str_update(self, s: Node, index: Node, value: Node) -> Node: ...
    def str_replace(self, s: Node, old: Node, new: Node) -> Node: ...
    def str_replace_all(self, s: Node, old: Node, new: Node) -> Node: ...
    def str_to_lower(self, a: Node) -> Node: ...
    def str_to_upper(self, a: Node) -> Node: ...
    def str_rev(self, a: Node) -> Node: ...
    def str_lt(self, a: Node, b: Node) -> Node: ...
    def str_le(self, a: Node, b: Node) -> Node: ...
    def str_contains(self, a: Node, b: Node) -> Node: ...
    def str_is_digit(self, a: Node) -> Node: ...
